---
interface Props {
  vertical?: boolean;
}

const { vertical = false } = Astro.props;

const links = [
  { href: '/', label: 'Home' },
  { href: '/chi-siamo/', label: 'La Polisportiva' },
  { href: '/impianti/', label: 'Impianti e Attività' },
  { href: '/casa-del-giovane/', label: 'Casa del Giovane' },
  { href: '/news/', label: 'News ed Eventi' },
  { href: '/contatti/', label: 'Contatti' },
];

const path = Astro.url.pathname;
---

<ul class:list={['nav-list', { 'nav-list--vertical': vertical }]}>
  {links.map((link) => {
    const isActive = link.href === '/' ? path === '/' : path.startsWith(link.href);
    return (
      <li>
        <a href={link.href} class:list={{ active: isActive }} aria-current={isActive ? 'page' : undefined}>
          {link.label}
        </a>
      </li>
    );
  })}
</ul>

<style>
  .nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }
  .nav-list--vertical {
    flex-direction: column;
    gap: 0.5rem;
  }
  a {
    color: var(--color-text);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    padding: 0.25rem 0;
  }
  a:hover {
    color: var(--color-primary);
  }
  a.active {
    color: var(--color-primary);
    font-weight: 600;
  }
</style>
