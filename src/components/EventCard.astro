---
import type { NewsEntry } from '../lib/news';

interface Props {
  entry: NewsEntry;
}

const { entry } = Astro.props;
const { title, eventDate, location } = entry.data;

const dayFmt = new Intl.DateTimeFormat('it-IT', { day: 'numeric' });
const monthFmt = new Intl.DateTimeFormat('it-IT', { month: 'short' });

const day = eventDate ? dayFmt.format(eventDate) : '';
const month = eventDate ? monthFmt.format(eventDate) : '';
---

<article class="card event-card">
  <a class="event-link" href={`/news/${entry.id}/`}>
    <div class="event-date">
      <span class="event-day">{day}</span>
      <span class="event-month">{month}</span>
    </div>
    <div class="event-body">
      <h3 class="event-title">{title}</h3>
      {location && <p class="event-location">{location}</p>}
    </div>
  </a>
</article>

<style>
  .event-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }
  .event-date {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 4.25rem;
    padding: 0.6rem 0;
    border-radius: var(--radius-sm);
    background: var(--color-primary);
    color: #fff;
    line-height: 1;
  }
  .event-day {
    font-size: 1.5rem;
    font-weight: 800;
  }
  .event-month {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    opacity: 0.9;
    margin-top: 0.15rem;
  }
  .event-body {
    min-width: 0;
  }
  .event-title {
    font-size: 1.05rem;
    line-height: 1.3;
  }
  .event-location {
    margin-top: 0.3rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
</style>
