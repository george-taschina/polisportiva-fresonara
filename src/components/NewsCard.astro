---
import type { NewsEntry } from '../lib/news';

interface Props {
  entry: NewsEntry;
}

const { entry } = Astro.props;
const { title, description, pubDate, category, eventDate, location } = entry.data;

const labels: Record<string, string> = {
  news: 'Notizia',
  evento: 'Evento',
  'casa-del-giovane': 'Casa del Giovane',
};

const df = new Intl.DateTimeFormat('it-IT', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const pubDateFormatted = df.format(pubDate);
const eventDateFormatted = eventDate ? df.format(eventDate) : undefined;
---

<article class="card">
  <a class="card-link" href={`/news/${entry.id}/`}>
    <div class="card-body">
      <div class="card-meta">
        <span class={`badge badge--${category}`}>{labels[category]}</span>
        <time datetime={pubDate.toISOString()}>{pubDateFormatted}</time>
      </div>
      <h3 class="card-title">{title}</h3>
      <p class="card-desc">{description}</p>
      {category === 'evento' && eventDateFormatted && (
        <p class="card-event">
          <strong>📅 {eventDateFormatted}</strong>
          {location && <span> — {location}</span>}
        </p>
      )}
    </div>
  </a>
</article>

<style>
  .card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    height: 100%;
  }
  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .card-meta time {
    color: var(--color-muted);
    font-size: 0.85rem;
  }
  .card-title {
    font-size: 1.15rem;
  }
  .card-desc {
    color: var(--color-muted);
    font-size: 0.95rem;
  }
  .card-event {
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--color-border);
    font-size: 0.9rem;
    color: var(--color-ink);
  }
</style>
